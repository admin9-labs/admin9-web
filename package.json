{
  "name": "admin9-pro",
  "description": "Admin9 Pro - 企业中后台管理系统，基于 Vue 和 Arco Design Pro",
  "version": "1.0.9",
  "private": true,
  "author": "Admin9 Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config ./config/vite.config.dev.ts",
    "build": "vue-tsc --noEmit && vite build --config ./config/vite.config.prod.ts",
    "report": "cross-env REPORT=true pnpm build",
    "preview": "pnpm build && vite preview --host",
    "type:check": "vue-tsc --noEmit --skipLibCheck",
    "test:auth-session": "tsx --test scripts/auth-session.test.ts",
    "test:auth-runtime": "tsx --test scripts/auth-runtime.test.ts",
    "test:auth-production-runtime": "tsx --test scripts/auth-production-runtime.test.ts",
    "test:admin-menu": "tsx --test scripts/admin-menu.test.ts",
    "test:admin-editor": "tsx --test scripts/admin-editor.test.ts",
    "test:file-upload": "tsx --test scripts/file-upload.test.ts scripts/file-picker-groups.test.ts",
    "test:system-settings": "tsx --test scripts/system-settings.test.ts",
    "test:api-contract": "tsx --test scripts/admin-api-contract.test.ts",
    "test:unit": "tsx --test scripts/*.test.ts",
    "openapi:generate": "tsx scripts/openapi-contract.ts generate",
    "openapi:check": "tsx scripts/openapi-contract.ts check",
    "lint-staged": "lint-staged",
    "lint:fix": "eslint --fix \"./src/**/*.{js,ts,vue}\"",
    "prepare": "husky install",
    "new": "plop",
    "format": "prettier --write ./src && pnpm lint:fix",
    "lint": "eslint \"./src/**/*.{js,ts,vue}\"",
    "lint:styles": "stylelint \"src/**/*.{vue,less,css}\"",
    "audit:dependencies": "tsx scripts/dependency-audit.ts"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.vue": [
      "stylelint --fix",
      "prettier --write",
      "eslint --fix"
    ],
    "*.{less,css}": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@admin9-labs/admin9-ui": "^0.28.0",
    "@arco-design/web-vue": "^2.58.0",
    "@vueuse/core": "^9.13.0",
    "axios": "^0.34.0",
    "dayjs": "^1.11.13",
    "lodash": "^4.18.1",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.4.1",
    "sortablejs": "^1.15.6",
    "vue": "^3.5.42",
    "vue-i18n": "^9.14.5",
    "vue-jsonp": "^2.1.0",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@arco-plugins/vite-vue": "^1.4.5",
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@types/lodash": "^4.17.20",
    "@types/nprogress": "^0.2.3",
    "@types/sortablejs": "^1.15.8",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "@vue/babel-plugin-jsx": "^1.4.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^8.0.3",
    "less": "^4.4.0",
    "lint-staged": "^15.5.2",
    "openapi-typescript": "7.13.0",
    "plop": "^4.0.5",
    "pluralize": "^8.0.0",
    "postcss": "^8.5.28",
    "postcss-html": "^1.8.0",
    "postcss-less": "^6.0.0",
    "prettier": "^2.8.8",
    "rollup-plugin-visualizer": "^5.14.0",
    "sharp": "^0.35.5",
    "stylelint": "^16.23.0",
    "stylelint-config-recess-order": "^6.1.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-order": "^6.0.4",
    "svgo": "^4.1.0",
    "tailwindcss": "3",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "unplugin-vue-components": "^0.24.1",
    "vite": "~6.4.3",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-svg-loader": "^3.6.0",
    "vue-tsc": "~3.3.12"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "pnpm": "10.34.6"
  },
  "packageManager": "pnpm@10.34.6",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "vue-demi"
    ],
    "overrides": {
      "brace-expansion@>=1 <1.1.20": "^1.1.20",
      "brace-expansion@>=2 <2.1.6": "^2.1.6",
      "browserslist@<4.28.7": "^4.28.7",
      "defu@<6.1.5": "^6.1.5",
      "fast-uri@>=3 <3.1.7": "^3.1.7",
      "flatted@>=3 <3.4.2": "^3.4.2",
      "glob@>=10.2 <10.5": "^10.5.0",
      "handlebars@<4.7.9": "^4.7.9",
      "js-yaml@>=3 <3.15.2": "^3.15.2",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "minimatch@>=3 <3.1.4": "^3.1.4",
      "minimatch@>=7 <7.4.8": "^7.4.8",
      "minimatch@>=9 <9.0.7": "^9.0.7",
      "minimatch@>=10 <10.2.3": "^10.2.3",
      "nanoid@>=3 <3.3.18": "^3.3.18",
      "picomatch@>=2 <2.3.2": "^2.3.2",
      "picomatch@>=4 <4.0.4": "^4.0.4",
      "rollup@>=2 <2.80": "^2.80.0",
      "svgo@>=2 <2.8.4": "^2.8.4",
      "tmp@>=0.2 <0.2.6": "^0.2.6",
      "vite>sugarss": "-",
      "ajv@>=6 <6.14": "^6.14.0",
      "ajv@>=8 <8.18": "^8.18.0",
      "yaml@>=2 <2.8.3": "^2.8.3",
      "diff@>=4 <4.0.4": "^4.0.4",
      "follow-redirects@<1.16": "^1.16.0",
      "@babel/core@>=7 <7.29.6": "^7.29.6",
      "postcss-selector-parser@>=6 <7.1.6": "^7.1.6",
      "source-map-js@<1.2.2": "^1.2.2",
      "colord@<2.9.4": "^2.9.4",
      "braces@3.0.3": "npm:@dieub/braces-depth-guard@3.0.3-pn.3"
    }
  }
}
