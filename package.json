{
  "name": "admin9-pro",
  "description": "Admin9 Pro - 企业中后台管理系统，基于 Vue 和 Arco Design Pro",
  "version": "1.0.0",
  "private": false,
  "packageManager": "pnpm@10.10.0",
  "author": "Admin9 Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config ./config/vite.config.dev.ts",
    "build": "vue-tsc --noEmit && vite build --config ./config/vite.config.prod.ts",
    "build:ui": "pnpm --filter @admin9-labs/admin9-ui build",
    "report": "cross-env REPORT=true npm run build",
    "preview": "npm run build && vite preview --host",
    "type:check": "vue-tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint-staged": "npx lint-staged",
    "lint": "pnpm lint:eslint && pnpm lint:style",
    "lint:eslint": "eslint \"./src/**/*.{js,jsx,ts,tsx,vue}\" \"./packages/admin9-ui/src/**/*.{js,jsx,ts,tsx,vue}\" \"./tests/**/*.{js,jsx,ts,tsx}\" \"./scripts/**/*.{js,jsx,ts,tsx}\"",
    "lint:style": "stylelint \"./src/**/*.{css,less,vue}\" \"./packages/admin9-ui/src/**/*.{css,less,vue}\"",
    "lint:fix": "eslint --fix \"./src/**/*.{js,jsx,ts,tsx,vue}\"",
    "prepare": "husky install",
    "format": "prettier --write ./src && npm run lint:fix",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "openapi:generate": "tsx scripts/openapi-contract.ts generate",
    "openapi:check": "tsx scripts/openapi-contract.ts check"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.vue": [
      "stylelint --fix",
      "prettier --write",
      "eslint --fix"
    ],
    "*.{less,css}": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@tiptap/core": "^3.20.0",
    "@vueuse/core": "^9.13.0",
    "axios": "^0.33.0",
    "dayjs": "^1.11.19",
    "echarts": "^6.1.0",
    "lodash": "^4.18.1",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^4.7.1",
    "query-string": "^8.2.0",
    "quill": "^2.0.3",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.29",
    "vue-i18n": "^9.14.5",
    "vue-jsonp": "^2.1.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@admin9-labs/admin9-ui": "workspace:*",
    "@arco-plugins/vite-vue": "^1.4.6",
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@tiptap/vue-3": "^2.27.2",
    "@types/lodash": "^4.17.24",
    "@types/nprogress": "^0.2.3",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitejs/plugin-vue-jsx": "4.2.0",
    "@vue/babel-plugin-jsx": "^1.5.0",
    "autoprefixer": "^10.4.24",
    "consola": "^2.15.3",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "20.8.9",
    "husky": "^8.0.3",
    "less": "^4.5.1",
    "lint-staged": "^13.3.0",
    "openapi-typescript": "6.7.6",
    "postcss": "8.5.18",
    "postcss-html": "^1.8.1",
    "postcss-less": "^6.0.0",
    "prettier": "^2.8.8",
    "rollup": "^2.80.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "stylelint": "^16.26.1",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-order": "^6.0.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^4.9.5",
    "unplugin-vue-components": "^0.24.1",
    "vite": "6.4.3",
    "vite-plugin-compression": "^0.5.1",
    "vite-svg-loader": "^3.6.0",
    "vitest": "3.2.6",
    "vue-tsc": "^1.8.27"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "pnpm": {
    "overrides": {
      "rollup@2": "^2.79.2"
    }
  }
}
